<%# # er jaigai = dile string akare dekhay html escape kore # jaigai - dile html value ashe %>
<%- include("includes/head.ejs") %>
 <!-- view er includes folder theke head.ejs include korbe. mane head part ta. -->
<body>
    <h1> This page belongs to @<%= data.name %> </h1>

    <button>Follow</button>
    <button>Message</button>
   <p>Followers : <%= data.followers %></p>
   <p>Following : <%= data.following %></p>
    
    <%  for(let post of data.posts){ %>
    <img src="<%= post.image %>" alt="some img">
    <p>
        Likes : <%= post.likes %> &nbsp; &nbsp; &nbsp; &nbsp; Comments :  <%= post.comments %> 
    </p>
    <%  } %>
    <%- include("includes/footer.ejs") %>
</body>
<script src="/app.js"></script>
</html>

